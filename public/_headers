# Cache and security headers. Understood by Cloudflare Pages and Netlify.

# Vite fingerprints these filenames, so a new build produces a new URL and the
# old one can be cached indefinitely.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html must never be cached hard, or visitors keep getting the old app
# shell pointing at assets that no longer exist.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
