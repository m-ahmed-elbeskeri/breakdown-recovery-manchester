# Copy to .env.local and adjust as needed.
#
# VITE_API_URL: Base URL of the backend API (the FastAPI service in ./backend).
# Defaults to http://localhost:8000 when unset. Set this to your deployed API
# URL in staging/production. When the API is unreachable the site still works:
# live metrics fall back to simulated figures and bookings are queued in the
# browser's localStorage, then re-sent automatically once the API is back.
VITE_API_URL="http://localhost:8000"
