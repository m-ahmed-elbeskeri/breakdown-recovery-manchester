# Copy to .env and fill in.

# Postgres connection string. Get a free one from Neon (https://neon.tech):
#   Project → Connection Details → copy the "psql"/URI string.
# Works with any Postgres provider (Neon, Supabase, Render, …). The app
# normalises the driver automatically, so paste the URL exactly as given.
DATABASE_URL="postgresql://user:password@ep-xxxx.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# Shared secret for the protected admin endpoints (GET /api/bookings).
# Generate one, e.g.  python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_API_KEY="change-me"

# Comma-separated browser origins allowed to call the API (the site).
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:5180,http://localhost:5180"

# Email alerts on new bookings (optional). Get a free API key from
# https://resend.com. Leave RESEND_API_KEY empty to disable alerts.
# Without a verified domain, Resend can send from onboarding@resend.dev to the
# email you signed up with — set NOTIFY_EMAIL_TO to that address.
RESEND_API_KEY=""
NOTIFY_EMAIL_FROM="onboarding@resend.dev"
NOTIFY_EMAIL_TO=""
